generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum StreamPlatform {
  KICK
}

enum NotificationStatus {
  LIVE
}

enum BotActivityType {
  PLAYING
  WATCHING
  LISTENING
  COMPETING
  CUSTOM
}

enum GuildMembershipState {
  UNKNOWN
  CONNECTED
  LEFT
}

model DiscordGuild {
  id                     String               @id
  name                   String?
  iconHash               String?
  membershipState        GuildMembershipState @default(UNKNOWN)
  alertChannelId         String?
  isAllowed              Boolean              @default(false)
  allowlistNotes         String?
  allowedByDiscordUserId String?
  allowedAt              DateTime?
  joinedAt               DateTime?
  leftAt                 DateTime?
  lastSeenAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  streamers              TrackedStreamer[]
  notifications          Notification[]

  @@index([membershipState, name])
  @@index([isAllowed, name])
}

model TrackedStreamer {
  id                   String         @id @default(uuid())
  guildId              String
  platform             StreamPlatform @default(KICK)
  username             String
  normalizedUsername   String
  enabled              Boolean        @default(true)
  lastKnownLiveState   Boolean        @default(false)
  currentLiveStartedAt DateTime?
  lastNotifiedLiveAt   DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  guild                DiscordGuild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  notifications        Notification[]

  @@unique([guildId, platform, normalizedUsername])
  @@index([guildId, enabled])
  @@index([platform, normalizedUsername])
}

model Notification {
  id                 String             @id @default(uuid())
  guildId            String
  streamerId         String?
  streamerUsername   String
  normalizedUsername String
  platform           StreamPlatform
  status             NotificationStatus
  streamUrl          String
  title              String?
  category           String?
  thumbnailUrl       String?
  viewerCount        Int?
  streamStartedAt    DateTime
  discordMessageId   String?
  sentAt             DateTime?
  guild              DiscordGuild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  streamer           TrackedStreamer?   @relation(fields: [streamerId], references: [id], onDelete: SetNull)

  @@unique([guildId, platform, normalizedUsername, streamStartedAt])
  @@index([guildId, sentAt, id])
  @@index([streamerId, sentAt])
}

model BotSettings {
  id                      String           @id @default("default")
  allowlistEnforced       Boolean          @default(false)
  rotationEnabled         Boolean          @default(true)
  rotationIntervalSeconds Int              @default(60)
  defaultStatusEnabled    Boolean          @default(true)
  defaultStatusText       String?
  defaultActivityType     BotActivityType?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
}

model PresenceMessage {
  id              String          @id @default(uuid())
  text            String
  activityType    BotActivityType
  enabled         Boolean         @default(true)
  sortOrder       Int             @default(0)
  usePlaceholders Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([enabled, sortOrder])
  @@index([sortOrder])
}

model GlobalAdmin {
  discordId String   @id
  createdAt DateTime @default(now())
}
