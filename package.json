{
  "name": "kickbot-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Unified NestJS API and Discord bot for Kick livestream notifications",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "start:prod": "node --enable-source-maps dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "oxlint src test *.config.ts",
    "format": "prisma format && prettier --write \"{src,test}/**/*.ts\" \"*.{ts,json,md,yml,yaml}\"",
    "format:check": "prisma validate && prettier --check \"{src,test}/**/*.ts\" \"*.{ts,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@fastify/static": "10.1.4",
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "1.20.0",
    "cheerio": "^1.2.0",
    "discord-api-types": "0.37.120",
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "jose": "6.2.12",
    "necord": "7.0.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "12.0.5",
    "@nestjs/testing": "12.1.0",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@vitest/coverage-v8": "5.0.2",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.8",
    "mysql2": "3.24.4",
    "ws": "8.21.3"
  }
}
