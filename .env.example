NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://kickbot:kickbot@localhost:5432/kickbot?schema=public
# Heroku + Supabase: use the Session pooler on port 5432 and append ?sslmode=require.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PERCENT_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
LOG_LEVEL=log

DISCORD_ENABLED=true
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4000/api/v1/auth/discord/callback
DISCORD_DEVELOPMENT_GUILD_ID=
DISCORD_BOT_PERMISSIONS=3230720
DISCORD_OAUTH_SCOPES=identify guilds

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_API_BASE_URL=https://api.kick.com
KICK_TOKEN_URL=https://id.kick.com/oauth/token
KICK_SCOPES=
KICK_REQUEST_TIMEOUT_MS=8000
KICK_MAX_RETRIES=3
KICK_RETRY_BASE_DELAY_MS=1000
POLL_INTERVAL_SECONDS=60
PROVIDER_MAX_CONCURRENCY=4
BOT_PRESENCE_SYNC_INTERVAL_SECONDS=60
MYINSTANTS_REQUEST_TIMEOUT_MS=8000
MYINSTANTS_CACHE_TTL_SECONDS=300
MYINSTANTS_USER_AGENT=KickBot/2.0
INSTANT_AUDIO_MAX_BYTES=5242880
INSTANT_MAX_DURATION_SECONDS=30
INSTANT_MAX_QUEUE_LENGTH=20
INSTANT_USER_COOLDOWN_SECONDS=3
INSTANT_MAX_ACTIVE_GUILDS=5
INSTANT_IDLE_DISCONNECT_SECONDS=30

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MUSIC_MAX_DURATION_SECONDS=7200
MUSIC_MAX_PLAYLIST_ITEMS=25
MUSIC_MAX_QUEUE_LENGTH=50
MUSIC_MAX_ACTIVE_GUILDS=2
MUSIC_RESOLVE_TIMEOUT_MS=20000

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SESSION_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=kickbot_session
OAUTH_STATE_COOKIE_NAME=kickbot_oauth_state
COOKIE_SECURE=false
COOKIE_DOMAIN=
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_ADMIN_DISCORD_IDS=
SWAGGER_UI_ENABLED=true
